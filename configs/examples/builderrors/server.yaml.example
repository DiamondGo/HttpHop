# Production-style: ai.builderrors.com, Client uses same host + /tunnel/* paths.
# Copy to configs/local/ or /etc/httphop/ — see configs/README.md

public_listen: ":443"
http_listen: ":80"
root_domain: "builderrors.com"
control_path: "/tunnel"

tls:
  cache_dir: "/var/lib/httphop/certs"
  email: "admin@builderrors.com"
  disable: false

tunnel:
  poll_timeout: 30s
  session_timeout: 60s
  max_streams_per_tunnel: 256

proxy:
  response_header_timeout: 60s

clients:
  - client_id: "myai"
    subdomain: "ai"
    token_file: "../secrets/myai.token"
    max_clients: 1

  # - client_id: "myblog"
  #   subdomain: "blog"
  #   token_file: "../secrets/myblog.token"
  #   max_clients: 1

status:
  enabled: true
  listen: "127.0.0.1:9090"

logging:
  level: "info"
