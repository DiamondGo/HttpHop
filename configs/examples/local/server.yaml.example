# Local dev: TLS off, httphop listens on :8443.
# Copy to configs/local/ — see configs/README.md

public_listen: ":443"
http_listen: ":80"
root_domain: "httphop.io"
control_path: "/tunnel"

tls:
  cache_dir: "/var/lib/httphop/certs"
  email: "admin@httphop.io"
  disable: true
dev_listen: ":8443"

tunnel:
  poll_timeout: 30s
  session_timeout: 60s
  sweep_interval: 5s
  coalesce_window: 2ms
  poll_buffer_size: 262144
  max_send_bytes: 1048576
  high_water_warn: 0
  poll_mode: "batch"
  max_streams_per_tunnel: 256

proxy:
  response_header_timeout: 60s
  read_header_timeout: 10s
  max_header_bytes: 65536

clients:
  - client_id: "home-gpu-01"
    subdomain: "myapp"
    token_file: "../secrets/home-gpu-01.token"
    max_clients: 1

  # - client_id: "home-blog-01"
  #   subdomain: "blog"
  #   token_file: "../secrets/home-blog-01.token"
  #   max_clients: 1

status:
  enabled: true
  listen: "127.0.0.1:9090"

logging:
  level: "info"
