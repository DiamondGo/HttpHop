# Pair with configs/examples/local/server.yaml.example (client_id must match).

client_id: "home-gpu-01"

server:
  url: "http://127.0.0.1:8443"
  token_file: "../secrets/home-gpu-01.token"
  insecure_skip_verify: true

local:
  target: "127.0.0.1:8080"
  host_header_rewrite: ""

transport:
  poll_interval: 0s
  poll_grace: 10s

health:
  enabled: true
  mode: "tcp"
  interval: 15s
  timeout: 3s

logging:
  level: "info"
